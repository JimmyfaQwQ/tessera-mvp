{
  "name": "tessera",
  "displayName": "Tessera",
  "description": "Syntax highlighting, language configuration, and snippets for the Tessera language (.tss files).",
  "version": "0.4.1",
  "publisher": "tessera-lang",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/JimmyfaQwQ/tessera-mvp"
  },
  "contributes": {
    "languages": [
      {
        "id": "tessera",
        "aliases": [
          "Tessera",
          "tss"
        ],
        "extensions": [
          ".tss"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "tessera",
        "scopeName": "source.tessera",
        "path": "./syntaxes/tessera.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "tessera",
        "path": "./snippets/tessera.json"
      }
    ]
  }
}
