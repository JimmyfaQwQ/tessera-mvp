@template with_workers(worker_count: int) {
    define workers: Queue<thread<worker>>;
    define holders: List<thread<worker_holder>>;

    function __on_enter__(): void {
        self.workers = Queue<thread<worker>>();
        self.holders = List<thread<worker_holder>>();
        for (let i: int = 0; i < self.worker_count; i = i + 1) {
            $worker("Worker " + i) {
                await keepalive();
            } := worker;
            $worker_holder(self.workers, worker) {
                await run();
            } := holder;
            self.holders.push(holder);
        }
    }

    function __on_exit__(): void {
        for (let i: int = 0; i < self.worker_count; i = i + 1) {
            let holder: thread<worker_holder> = self.holders.get(i);
            holder.try_terminate();
            holder.can_terminate.wait();
            holder.terminate();
        }
    }
}

$template reader() {
    define line_available: permit;
    define line: Queue<String>;

    function __on_enter__(): void {
        self.line_available = permit();
        self.line = Queue<String>();
    }

    function __on_exit__(): void {
    }

    async function run(): void {
        let buf: String = "";
        while (true) {
            let ch: Option<char> = getchar();
            if (ch.isNone()) {
                if (buf != "") {
                    #exclusive {
                        self.line.enqueue(buf);
                        self.line_available.release();
                    }
                }
                break;
            }
            let c: char = ch.unwrap();
            if (c == '\n') {
                #exclusive {
                    self.line.enqueue(buf);
                    self.line_available.release();
                }
                buf = "";
            } else if (c == '\r') {
                // skip carriage return (Windows \r\n line endings)
            } else {
                buf = buf + c;
            }
        }
    }

    async handler readLine(): String {
        print("> ");
        await self.line_available;
        let result: String = "";
        #exclusive {
            result = self.line.dequeue().unwrap();
        }
        return result;
    }
}

$template dispatcher(reader_handle: thread<reader>, threads: Queue<thread<worker>>) {
    async handler run(): void {
        while (true) {
            let hf: HandlerFuture<String> = self.reader_handle.readLine();
            if (hf.isErr()) {
                break;
            }
            let text: String = hf.wait();
            if (text == "quit") {
                break;
            }
            let worker: Option<thread<worker>> = self.threads.tryPop();
            if (worker.isSome()) {
                let w: thread<worker> = worker.unwrap();
                w.echo(text);
            } else {
                println("No available workers to handle the request.");
            }
        }
    }
}

$template worker_holder(pool: Queue<thread<worker>>, worker: thread<worker>) {
    expose can_terminate: contract;

    function __on_enter__(): void {
        self.can_terminate = contract();
    }

    async function run(): void {
        while (true) {
            await self.worker.available;
            self.worker.available.reset();
            self.pool.push(self.worker);
        }
    }

    async handler try_terminate(): void {
        await self.worker.terminate();
        self.can_terminate.fulfill();
    }
}

$template worker(name: String) {
    expose_mutable available: signal;

    function __on_enter__(): void {
        self.available = signal();
        self.available.raise();
    }

    async handler echo(msg: String): void {
        println("[" + self.name + "] " + msg);
        await asleep(1000);
        self.available.raise();
    }

    async function __on_terminate__(): void {
        println("[" + self.name + "] Terminating");
    }
}

println("Echo server — 输入 quit 退出");

$reader() {
    await run();
} := r;

println("请输入worker数量：");
let worker_count: int = 0;
while (true) {
    let line: String = r.readLine().wait();
    let parsed: Result<int, ParseError> = line.toInt();
    if (parsed.isOk()) {
        worker_count = parsed.unwrap();
        break;
    } else {
        println("请输入一个有效的整数：");
    }
}

println("启动了 " + worker_count + " 个worker... 输入并回车以分发任务。");

@with_workers(worker_count) {
    $dispatcher(r, workers) {
        await keepalive();
    } := d;

    d.run().wait();
}
