@template with_workers(worker_count: int) {
    define workers: Queue<thread<worker>>;
    define holders: List<thread<worker_holder>>;

    function __on_enter__(): void {
        workers = Queue<thread<worker>>();
        holders = List<thread<worker_holder>>();
        for (let i: int = 0; i < worker_count; i = i + 1) {
            $worker("Worker " + i) {
                await keepalive();
            } := worker;
            $worker_holder(workers, worker) {
                await run();
            } := holder;
            holders.push(holder);
        }
    }

    function __on_exit__(): void {
        for (let i: int = 0; i < worker_count; i = i + 1) {
            let w: thread<worker> = workers.dequeue().unwrap();
            w.terminate();
        }
    }
}

$template reader() {
    define line_available: permit;
    define line: Queue<String>;

    function __on_enter__(): void {
        line_available = permit();
        line = Queue<String>();
    }

    function __on_exit__(): void {
    }

    async function run(): void {
        let buf: String = "";
        while (true) {
            let ch: Option<char> = getchar();
            if (ch.isNone()) {
                if (buf != "") {
                    #exclusive {
                        line.enqueue(buf);
                        line_available.release();
                    }
                }
                break;
            }
            let c: char = ch.unwrap();
            if (c == '\n') {
                #exclusive {
                    line.enqueue(buf);
                    line_available.release();
                }
                buf = "";
            } else if (c == '\r') {
                // skip carriage return (Windows \r\n line endings)
            } else {
                buf = buf + c;
            }
        }
    }

    async handler readLine(): String {
        print("> ");
        await line_available;
        let result: String = "";
        #exclusive {
            result = line.dequeue().unwrap();
        }
        return result;
    }
}

$template dispatcher(reader_handle: thread<reader>, threads: Queue<thread<worker>>) {
    async handler run(): void {
        while (true) {
            let res: Result<String, HandlerDispatchError> = reader_handle.readLine().waitHandler();
            if (res.isErr()) {
                break;
            }
            let text: String = res.unwrap();
            if (text == "quit") {
                break;
            }
            let worker: Option<thread<worker>> = threads.tryPop();
            if (worker.isSome()) {
                let w: thread<worker> = worker.unwrap();
                w.echo(text);
            } else {
                println("No available workers to handle the request.");
            }
        }
    }
}

$template worker_holder(pool: Queue<thread<worker>>, worker: thread<worker>) {
    async function run(): void {
        while (true) {
            await worker.available;
            worker.available.reset();
            pool.push(worker);
        }
    }
}

$template worker(name: String) {
    expose_mutable available: signal;

    function __on_enter__(): void {
        available = signal();
        available.raise();
    }

    async handler echo(msg: String): void {
        println("[" + name + "] " + msg);
        await asleep(1000);
        available.raise();
    }

    async function __on_terminate__(): void {
        println("[" + name + "] Terminating");
    }
}

println("Echo server — 输入 quit 退出");

$reader() {
    await run();
} := r;

println("请输入worker数量：");
let worker_count: int = 0;
while (true) {
    let line: Result<String, HandlerDispatchError> = r.readLine().waitHandler();
    let parsed: Result<int, ParseError> = line.unwrap().toInt();
    if (parsed.isOk()) {
        worker_count = parsed.unwrap();
        break;
    } else {
        println("请输入一个有效的整数：");
    }
}

println("启动了 " + worker_count + " 个worker... 输入并回车以分发任务。");

@with_workers(worker_count) {
    $dispatcher(r, workers) {
        await keepalive();
    } := d;

    d.run().waitHandler();
}
