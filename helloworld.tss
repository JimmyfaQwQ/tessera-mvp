$template reader() {
    define line_available: bool;

    function __on_enter__(): void {
        line_available = false;
    }

    async function run(): void {
        let buf: String = "";
        while (true) {
            let ch: Option<char> = getchar();
            if (ch.isNone()) {
                if (buf != "") {
                    #exclusive {
                        line.enqueue(buf);
                        line_available = true;
                    }
                }
                break;
            }
            let c: char = ch.unwrap();
            if (c == '\n') {
                #exclusive {
                    println("enque: " + buf);
                    line.enqueue(buf);
                    line_available = true;
                    buf = "";
                }
            } else if (c == '\r') {
                // skip carriage return (Windows \r\n line endings)
            } else {
                buf = buf + c;
            }
        }
    }

    async function __on_terminate__(): void {
        line_available = false;
    }

    // 跨线程调用：从队列取一行，队列空时将 line_available 置 false
    async handler readLine(): Option<String> {
        while (!line_available) {
            asleep(10);
        }
        let result: Option<String> = None;
        #exclusive {
            result = line.dequeue();
            if (line.isEmpty()) {
                line_available = false;
            }
        }
        return result;
    }
}

$template dispatcher(reader_handle: thread<reader>, threads: List<thread<worker>>) {
    async handler run(): void {
        let running: bool = true;
        let worker_index: int = 0;
        while (running) {
            let res: Result<Option<String>, HandlerDispatchError> = reader_handle.readLine().waitHandler();
            if (res.isOk()) {
                let opt: Option<String> = res.unwrap();
                if (opt.isSome()) {
                    let text: String = opt.unwrap();
                    if (text == "quit") {
                        running = false;
                    } else {
                        let w: thread<worker> = threads[worker_index];
                        w.echo(text).waitHandler();
                        worker_index = (worker_index + 1) % threads.length();
                    }
                }
            }
        }
    }
}

$template worker(name: String) {
    async handler echo(msg: String): void {
        println("[" + name + "] " + msg);
    }
}

println("Echo server — 输入 quit 退出");

$reader() {
    let line: Queue<String> = Queue<String>();
    await run();
} := r;

let workers: List<thread<worker>> = List<thread<worker>>();
for (let i: int = 0; i < 3; i = i + 1) {
    $worker("Worker-" + i) {
        await keepalive();
    } := w;
    workers.push(w);
}

$dispatcher(r, workers) {
    await keepalive();
} := d;

d.run().waitHandler();

r.terminate().wait();
