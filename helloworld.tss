@template with_workers(worker_count: int) {
    define workers: List<thread<worker>>;

    function __on_enter__(): void {
        workers = List<thread<worker>>();
        for (let i: int = 0; i < worker_count; i = i + 1) {
            $worker("Worker-" + i) {
                await keepalive();
            } := w;
            workers.push(w);
        }
    }
    function __on_exit__(): void {
        for (let i = 0; i < workers.length(); i = i + 1) {
            workers[i].terminate().wait();
        }
    }
}

$template reader() {
    define line_available: bool;
    define line: Queue<String>;

    function __on_enter__(): void {
        line_available = false;
        line = Queue<String>();
    }

    async function run(): void {
        let buf: String = "";
        while (true) {
            let ch: Option<char> = getchar();
            if (ch.isNone()) {
                if (buf != "") {
                    #exclusive {
                        line.enqueue(buf);
                        line_available = true;
                    }
                }
                break;
            }
            let c: char = ch.unwrap();
            if (c == '\n') {
                #exclusive {
                    line.enqueue(buf);
                    line_available = true;
                }
                buf = "";
            } else if (c == '\r') {
                // skip carriage return (Windows \r\n line endings)
            } else {
                buf = buf + c;
            }
        }
    }

    async function __on_terminate__(): void {
        line_available = false;
    }

    async handler readLine(): Option<String> {
        while (!line_available) {
            asleep(10);
        }
        let result: Option<String> = None;
        #exclusive {
            result = line.dequeue();
            if (line.isEmpty()) {
                line_available = false;
            }
        }
        return result;
    }
}

$template dispatcher(reader_handle: thread<reader>, threads: List<thread<worker>>) {
    async handler run(): void {
        while (true) {
            let res: Result<Option<String>, HandlerDispatchError> = reader_handle.readLine().waitHandler();
            if (res.isErr()) {
                break;
            }
            let opt: Option<String> = res.unwrap();
            if (opt.isSome()) {
                let text: String = opt.unwrap();
                if (text == "quit") {
                    break;
                }
                let assigned: bool = false;
                for (let i = 0; i < threads.length(); i = i + 1) {
                    let worker_thread: thread<worker> = threads[i];
                    if (worker_thread.available.isRaised()) {
                        worker_thread.available.reset();
                        worker_thread.echo(text);
                        assigned = true;
                        break;
                    }
                }
                if (!assigned) {
                    println("[Dispatcher] No available worker for: " + text);
                }
            }
        }
    }
}

$template worker(name: String) {
    expose_mutable available: signal;

    function __on_enter__(): void {
        available = signal();
        available.raise();
    }

    async handler echo(msg: String): void {
        println("[" + name + "] " + msg);
        await asleep(1000);
        available.raise();
    }

    async function __on_terminate__(): void {
        println("[" + name + "] Terminating");
    }
}

@with_workers(3) {
    println("Echo server — 输入 quit 退出");

    $reader() {
        await run();
    } := r;

    $dispatcher(r, workers) {
        await keepalive();
    } := d;

    d.run().waitHandler();

    r.terminate().wait();
}