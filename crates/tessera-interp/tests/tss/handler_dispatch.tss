$template Counter() {
    expose count: int;

    function __on_enter__(): void {
        self.count = 0;
    }

    async handler increment() {
        self.count = self.count + 1;
    }
}

$Counter() {
    await keepalive();
} := ctr;

let hf1: HandlerFuture<void> = ctr.increment();
let hf2: HandlerFuture<void> = ctr.increment();
let hf3: HandlerFuture<void> = ctr.increment();

hf1.wait();
hf2.wait();
hf3.wait();

ctr.terminate().wait();

let v: int = ctr.count;
assert(v == 3);
