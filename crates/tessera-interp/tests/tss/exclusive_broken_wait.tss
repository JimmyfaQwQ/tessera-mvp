// R-SYNC-BREAK-3: a Broken wakeup inside `#exclusive` resumes the exclusive
// coroutine's own continuation — it is not a foreign task interleaving, so
// per R-EXCL-1 the block stays atomic and Broken is delivered immediately
// (no defer-until-block-end). The cross-thread Broken here is driven by the
// owner thread's termination, which R-EXCL-4 explicitly blesses.
//
// This test pins down the no-deadlock + atomicity property: a `try await` on
// a signal whose owner has already terminated completes inside `#exclusive`,
// the post-await statement runs, and the block exits normally.

$template Owner() {
    expose sig: signal;
    function __on_enter__(): void { self.sig = signal(); }
    async function __on_terminate__(): void {}
}

$template Waiter(o: thread<Owner>) {
    expose_mutable log: Queue<String>;
    function __on_enter__(): void { self.log = Queue<String>(); }
    async function __on_terminate__(): void {}

    async function run(): void {
        self.log.push("enter");
        #exclusive {
            self.log.push("before_await");
            // owner is already terminated → sig is Broken(OwnerGone).
            let r: Result<void, error> = try await self.o.sig;
            assert(r.isErr());
            let e: error = r.unwrapErr();
            assert(e.kind == "OwnerGone");
            self.log.push("after_await");
        }
        self.log.push("outside_exclusive");
    }
}

// Bring the owner down BEFORE spawning the waiter so the signal is already
// Broken by the time `await` looks at it.
$Owner() { await keepalive(); } := owner;
owner.terminate().wait();

$Waiter(owner) { await run(); } := waiter;

// Let the waiter complete; `asleep` already blocks in sync contexts.
asleep(100);

assert(waiter.log.size() == 4);
let s0: String = waiter.log.tryPop().unwrap();
let s1: String = waiter.log.tryPop().unwrap();
let s2: String = waiter.log.tryPop().unwrap();
let s3: String = waiter.log.tryPop().unwrap();
assert(s0 == "enter");
assert(s1 == "before_await");
assert(s2 == "after_await");
assert(s3 == "outside_exclusive");

waiter.terminate().wait();
